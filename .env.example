GROQ_API_KEY=your_key_here
# GROQ_MODEL=openai/gpt-oss-120b   # llama-3.3-70b-versatile was retired by Groq on 2026-08-16

# Retrieval
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# USE_RERANKER=true
# MIN_RELEVANCE=0.35       # from eval/results.md; re-tune if you change models or documents

# App
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# LOG_TEXT=false           # true stores raw (non-crisis) text in logs
